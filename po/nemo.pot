msgstr ""

#: libnemo-private/org.nemo.gschema.xml:326
msgid "Use rounded corners in Files"
msgstr ""

#: libnemo-private/org.nemo.gschema.xml:327
msgid ""
"When false, the outside corners of file views, sidebar and preview are "
