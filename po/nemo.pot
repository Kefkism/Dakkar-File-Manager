#: libnemo-private/org.nemo.gschema.xml:338
msgid "Scale the Files sidebar"
msgstr ""

#: libnemo-private/org.nemo.gschema.xml:339
msgid ""
"Relative font and row scale for the sidebar; applies while dragging the zoom "
