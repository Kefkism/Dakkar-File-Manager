# ============================================================
# Dakkar - Git ignore rules
# Native C / GTK3 / Meson + Ninja / Debian / Arch / Flatpak
# ============================================================

# ------------------------------------------------------------
# Meson / Ninja: local build directories and generated metadata
# ------------------------------------------------------------
/build/
/build-*/
/build_*/
/_build*/
/cmake-build-*/
meson-private/
meson-logs/
meson-info/
meson-uninstalled/
compile_commands.json
build.ninja
.ninja_deps
.ninja_log

# ------------------------------------------------------------
# Release output (keep packaging recipes tracked!)
# ------------------------------------------------------------
/_release/
/dist/
*.deb
*.ddeb
*.rpm
*.flatpak
*.AppImage
*.pkg.tar.*
*.buildinfo
*.sig
packaging/
# ------------------------------------------------------------
# Flatpak Builder local state
# The current build script also uses ~/.cache/dakkar-flatpak-build
# ------------------------------------------------------------
/.flatpak-builder/
/flatpak-build/
/flatpak-repo/
/packaging/flatpak/.flatpak-builder/
/packaging/flatpak/build/
/packaging/flatpak/repo/

# ------------------------------------------------------------
# Arch / AUR: outputs generated by makepkg / prepare-local.sh
# Commit PKGBUILD; .SRCINFO belongs in the separate AUR repo.
# ------------------------------------------------------------
/packaging/aur/src/
/packaging/aur/pkg/
/packaging/aur/.SRCINFO
/packaging/aur/*.tar.gz
/packaging/aur/*.tar.xz
/packaging/aur/*.tar.zst
/packaging/aur/*.pkg.tar.*
/packaging/aur/*.buildinfo
/packaging/aur/*.sig
/packaging/aur/.makepkg/

# ------------------------------------------------------------
# C / GLib compiled objects, libraries and generated schemas
# ------------------------------------------------------------
*.o
*.obj
*.lo
*.la
*.lai
*.a
*.so
*.so.*
*.dylib
*.dll
*.exe
.libs/
.deps/
*.gschema.compiled
*.gmo
*.mo

# ------------------------------------------------------------
# Python caches (packaging / validation helpers)
# ------------------------------------------------------------
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.venv/
venv/

# ------------------------------------------------------------
# IDE and editor local settings
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.swn
*.kate-swp
*~

# ------------------------------------------------------------
# Logs, crash dumps, temporary/backup files
# ------------------------------------------------------------
*.log
*.tmp
*.temp
*.bak
*.old
*.orig
*.rej
*.core
core
core.*
*.crash

# ------------------------------------------------------------
# Local environment and private credentials
# Commit .env.example, never a real .env file.
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials.json

# ------------------------------------------------------------
# OS / file manager leftovers
# ------------------------------------------------------------
.DS_Store
._*
Thumbs.db
Desktop.ini
.Trash-*/

# Intentionally TRACK:
#   src/, data/, data/icons/, po/, gresources/
#   meson.build, meson_options.txt, README.md, COPYING*
#   packaging/deb/, packaging/aur/PKGBUILD,
#   packaging/sh/, packaging/flatpak/*.json, .github/
